{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casacava-invoice",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",

  // The built React app. Serving it from this same Worker is what makes the
  // browser build same-origin, so it needs no CORS and can use a plain cookie.
  // Requests for static files are free and do not run the Worker at all.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casacava-invoice",
      "database_id": "78126758-6fc4-4247-a7a1-3521c65a5a51"
    }
  ],

  "vars": {
    // Extra origins allowed to call the API. The Tauri origins are already
    // allowed by default; this is only for anything unusual.
    "ALLOWED_APP_ORIGINS": ""
  },

  "observability": { "enabled": true }
}

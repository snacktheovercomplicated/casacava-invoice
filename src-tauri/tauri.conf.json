{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CasaCava Invoices",
  "version": "1.0.0",
  "identifier": "com.casacavco.invoices",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "deno task dev:web",
    "beforeBuildCommand": "deno task build:web"
  },
  "app": {
    "windows": [
      {
        "title": "\u0643\u0627\u0632\u0627 \u0643\u0627\u0641\u0627 \u2014 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631",
        "width": 520,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://casacava-invoice.workers.dev https://*.workers.dev; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "publisher": "Casa Cava",
    "copyright": "Casa Cava",
    "shortDescription": "Casa Cava invoices",
    "longDescription": "Invoicing for Casa Cava. Works offline for drafts; issuing needs a connection."
  }
}
